# The release the site offers for download. Pages read these as
# %VITE_RELEASE_…% when they are built. Until the release exists on GitHub,
# VITE_RELEASE_OPEN is false and every download link reads "coming soon"
# instead (build/release.js); set it to true once the release is published.
VITE_RELEASE_OPEN=false
VITE_RELEASE_VERSION=0.1.0-alpha.1
VITE_RELEASE_URL=https://github.com/ZhiyinAgent/Zhiyin/releases/download/v0.1.0-alpha.1/Zhiyin-Setup-0.1.0-alpha.1.exe
VITE_RELEASE_NOTES=https://github.com/ZhiyinAgent/Zhiyin/releases/tag/v0.1.0-alpha.1
VITE_RELEASE_SIZE=156 MB

# Cloudflare Web Analytics site token, from the dashboard's Web Analytics page.
# Empty: no analytics script.
CF_WEB_ANALYTICS_TOKEN=
