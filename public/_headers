# Security headers for every page. The one inline script marks that scripts
# run; it is allowed by its hash. Cloudflare Web Analytics loads its beacon
# from static.cloudflareinsights.com and reports to cloudflareinsights.com. The
# videos come from R2, at media.zhiyinagent.app.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; media-src https://media.zhiyinagent.app; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Built files carry a content hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The videos' posters keep their names when they change: a week.
/media/*
  Cache-Control: public, max-age=604800
